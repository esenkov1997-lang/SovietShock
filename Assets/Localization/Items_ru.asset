  - m_Id: 17778974588739584
    m_Localized: "\u0421\u0430\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u044B\u0439
      \u0440\u0435\u043C\u043E\u043D\u0442\u043D\u044B\u0439 \u043A\u043B\u044E\u0447.
      \n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      \u043A\u0430\u043A \u0434\u043B\u044F \u043A\u0440\u0443\u0447\u0435\u043D\u0438\u044F
      \u0433\u0430\u0435\u043A, \u0442\u0430\u043A \u0438 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
      \u0433\u0430\u0437\u043E\u0432\u043E\u0439 \u0441\u0432\u0430\u0440\u043A\u0438.
      \n\u0414\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0443\u0432\u0435\u0441\u0438\u0441\u0442\u044B\u0439
      \u0438 \u043F\u0440\u043E\u0447\u043D\u044B\u0439.\n\u0415\u0441\u043B\u0438
      \u0441\u0442\u0443\u043A\u043D\u0443\u0442\u044C \u043F\u043E \u0433\u043E\u043B\u043E\u0432\u0435,
      \u043C\u0430\u043B\u043E \u043D\u0435 \u043F\u043E\u043A\u0430\u0436\u0435\u0442\u0441\u044F"
